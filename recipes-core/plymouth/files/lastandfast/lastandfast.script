# Lastandfast Plymouth Boot Theme

# Background
bg_image = Image("background.png");
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
bg_sprite = Sprite(bg_image.Scale(screen_width, screen_height));
bg_sprite.SetZ(-100);

# Logo - centered
logo_image = Image("logo.png");
logo_w = logo_image.GetWidth();
logo_h = logo_image.GetHeight();
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(screen_width / 2 - logo_w / 2);
logo_sprite.SetY(screen_height / 2 - logo_h / 2);
logo_sprite.SetZ(10);
